    "payment-service availability 1 -> 0",
    "checkout dependency error rate to payment-service ~95%",
    "checkout ERROR logs: payment-service call failed: connection refused"
  ],
  "alerts": [
    {
      "alertname": "HighErrorRate",
      "alert_type": "availability",
      "summary": "checkout-service 5xx ratio above 10%",
