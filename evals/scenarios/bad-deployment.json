{
  "id": "bad-deployment",
  "title": "Checkout rollout ships a broken order serializer",
  "kind": "positive",
  "description": "checkout-service 4.2.0 is rolled out 12 minutes before the alert; its order serializer throws on a new field, so a third of checkouts return 500.",
  "service": "checkout-service",
  "initial_conditions": "checkout-service healthy on 4.1.3; all dependencies healthy.",
  "observable_symptoms": [
    "checkout 5xx rate rises from ~0.2% to ~32% two minutes after a deployment",
    "ERROR logs: unhandled exception while serializing order"
  ],
  "alerts": [
    {
      "alertname": "HighErrorRate",
      "alert_type": "availability",
      "summary": "checkout-service 5xx ratio above 10%",
      "description": "Share of checkout requests answered with 5xx exceeded 10% for 5 minutes."
    }
  ],
  "world": {
    "metrics": {
      "checkout-service": {
        "error_rate": {
