# Copy to .env and adjust as needed for local development.
# See docs/architecture/06-database-design.md and ADR-0013 for why there
# are two schemas/roles instead of one connection string.

# --- Postgres (docker-compose) ---
POSTGRES_DB=incident_intelligence
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_PORT=5432

# incident-core's own role, scoped to the `incident_core` schema only
# (ADR-0013). Alembic migrations and the API/worker both connect as this
# role, never as the superuser, so the schema-level GRANT boundary is
# actually exercised in local dev, not just in production.
# No search_path override needed: every ORM model and migration is
# explicitly schema-qualified ("incident_core"."incidents", etc.), so the
# connection's default search_path never matters -- one less thing that
# can silently break if this URL is copy-pasted without the query string.
INCIDENT_CORE_DATABASE_URL=postgresql+psycopg://incident_core_role:incident_core_dev_password@localhost:5432/incident_intelligence

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Sharded stream topology (ADR-0014): one incident's events always land on
# the same shard stream (stream:events:0 .. stream:events:{N-1}), so a
# per-shard consumer sees that incident's events in order.
OUTBOX_STREAM_PREFIX=stream:events
OUTBOX_SHARD_COUNT=8

# Outbox relay tuning (apps/worker/main.py)
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_PUBLISH_ATTEMPTS=3
OUTBOX_RETRY_BACKOFF_SECONDS=0.5
POLL_INTERVAL_SECONDS=2.0

# Event consumer tuning (apps/worker/consumer_main.py)
CONSUMER_PURPOSE=metrics-consumer
CONSUMER_MAX_DELIVERIES=5
CONSUMER_CLAIM_MIN_IDLE_MS=30000

# --- App ---
LOG_LEVEL=INFO
API_PORT=8000
