    "payment deployment 14 minutes before the alert",
    "payment error rate 0.2% -> 60%",
    "checkout error rate 0.2% -> 30%, dependency errors to payment-service",
    "payment ERROR logs: NullPointerException in RefundHandler"
  ],
  "alerts": [
    {
      "alertname": "HighErrorRate",
      "alert_type": "availability",
      "summary": "checkout-service 5xx ratio above 10%",
      "description": "Share of checkout requests answered with 5xx exceeded 10% for 5 minutes."
    }
  ],
  "world": {
