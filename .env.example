# Copy to .env and adjust as needed for local development.
# See docs/architecture/06-database-design.md and ADR-0013 for why there
# are two schemas/roles instead of one connection string.

# --- Postgres (docker-compose) ---
POSTGRES_DB=incident_intelligence
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_PORT=5432

# incident-core's own role, scoped to the `incident_core` schema only
# (ADR-0013). Alembic migrations and the API/worker both connect as this
# role, never as the superuser, so the schema-level GRANT boundary is
# actually exercised in local dev, not just in production.
# No search_path override needed: every ORM model and migration is
# explicitly schema-qualified ("incident_core"."incidents", etc.), so the
# connection's default search_path never matters -- one less thing that
# can silently break if this URL is copy-pasted without the query string.
INCIDENT_CORE_DATABASE_URL=postgresql+psycopg://incident_core_role:incident_core_dev_password@localhost:5432/incident_intelligence

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Sharded stream topology (ADR-0014): one incident's events always land on
# the same shard stream (stream:events:0 .. stream:events:{N-1}), so a
# per-shard consumer sees that incident's events in order.
OUTBOX_STREAM_PREFIX=stream:events
OUTBOX_SHARD_COUNT=8

# Outbox relay tuning (apps/worker/main.py)
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_PUBLISH_ATTEMPTS=3
OUTBOX_RETRY_BACKOFF_SECONDS=0.5
POLL_INTERVAL_SECONDS=2.0

# Event consumer tuning (apps/worker/consumer_main.py)
CONSUMER_PURPOSE=metrics-consumer
CONSUMER_MAX_DELIVERIES=5
CONSUMER_CLAIM_MIN_IDLE_MS=30000

# --- App ---
LOG_LEVEL=INFO
API_PORT=8000

# --- Phase 3: Alertmanager webhook (infrastructure/alertmanager/alertmanager.yml) ---
# Shared secret Alertmanager presents as a Bearer token on
# POST /api/v1/alerts/alertmanager. Keep in sync with alertmanager.yml's
# http_config.authorization.credentials if you change it.
ALERTMANAGER_WEBHOOK_TOKEN=dev-local-alertmanager-token

# --- Phase 4: evidence-service (packages/evidence, apps/evidence) ---
# Its own role, scoped to the `evidence` schema only (ADR-0013); migrations
# run as this role too: `alembic -n evidence upgrade head`.
EVIDENCE_DATABASE_URL=postgresql+psycopg://evidence_service_role:evidence_service_dev_password@localhost:5432/incident_intelligence
# Read-only telemetry backends. Only evidence-service holds these URLs --
# nothing an agent can reach does (docs/architecture/13-security-boundaries.md).
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
# Git adapter: the repository whose history it may read, and the service
# catalog that scopes each service to its own paths + dependency neighbors.
EVIDENCE_GIT_REPO_PATH=.
EVIDENCE_SERVICE_CATALOG_PATH=infrastructure/evidence/service-catalog.json
EVIDENCE_API_PORT=8010

# --- Host port overrides (docker-compose + tests) ---
# Change these when the defaults are taken on your machine; keep the URLs
# above in step. GRAFANA_PORT maps Grafana's :3000.
# GRAFANA_PORT=3000
# Alertmanager (in Docker) delivers to the API on the host; follow API_PORT.
# ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:8000/api/v1/alerts/alertmanager

# --- Phase 5: investigation agent (packages/agents, apps/worker/investigation_main.py) ---
# The runtime model is configuration (ADR-0021). Tests never call it.
# Placeholders: nothing calls a provider until a live investigation or
# `evaluate --mode live` runs, and only then are credentials needed.
INVESTIGATION_PROVIDER=anthropic
INVESTIGATION_MODEL=claude-haiku-4-5
# auto: cache the stable prompt prefix (system prompt + tool definitions)
# where the provider/model supports it; off: never send cache hints.
INVESTIGATION_PROMPT_CACHE=auto
# low|medium|high|max (xhigh on newer models); ignored for models without effort.
INVESTIGATION_EFFORT=medium
# auto = adaptive thinking where the model supports it; off = never.
INVESTIGATION_THINKING=auto
INVESTIGATION_MAX_TOKENS=16000
INVESTIGATION_API_TIMEOUT_SECONDS=120
INVESTIGATION_API_MAX_RETRIES=2
INVESTIGATION_MODEL_ATTEMPTS=3
INVESTIGATION_RETRY_BACKOFF_SECONDS=2.0
# Budgets, frozen onto each investigation when it starts.
INVESTIGATION_MAX_ITERATIONS=15
INVESTIGATION_MAX_TOOL_CALLS=25
INVESTIGATION_MAX_IDENTICAL_TOOL_CALLS=2
INVESTIGATION_MAX_EVIDENCE_ITEMS=40
INVESTIGATION_MAX_WALL_CLOCK_SECONDS=900
INVESTIGATION_MAX_TOTAL_TOKENS=600000
# TRIAGING -> INVESTIGATING after this long; worker lease per investigation.
INVESTIGATION_DEBOUNCE_SECONDS=60
INVESTIGATION_LEASE_SECONDS=180
# Provider credentials: only needed for live runs (worker, investigate-live,
# `evaluate --mode live`). Read from the environment or this file; never
# logged or written into traces. Tests never need one.
# ANTHROPIC_API_KEY=

# --- Phase 6: evaluation + replay (packages/evaluation) ---
# A separate, disposable database (`make eval-db && make eval-migrate`); the
# harness resets it before every run and refuses a name without "eval"/"test".
EVAL_INCIDENT_CORE_DATABASE_URL=postgresql+psycopg://incident_core_role:incident_core_dev_password@localhost:5432/incident_intelligence_eval
EVAL_EVIDENCE_DATABASE_URL=postgresql+psycopg://evidence_service_role:evidence_service_dev_password@localhost:5432/incident_intelligence_eval

# --- Phase 7: remediation (packages/remediation, apps/worker/remediation_main.py) ---
# Operator endpoints (approval, proposals, kill switches) are disabled unless
# a token is set. Approver roles come only from this roster.
OPERATOR_API_TOKEN=
# REMEDIATION_APPROVERS=alice=service_owner|on_call_engineer,dave=on_call_engineer
REMEDIATION_APPROVERS=
# No approval within this window -> cancelled + escalated (never auto-approved).
REMEDIATION_APPROVAL_TIMEOUT_MINUTES=30
REMEDIATION_LEASE_SECONDS=120

# --- Phase 8: verification (apps/worker/verification_main.py) ---
# Multiplies every verification window from the action catalog (grace,
# poll interval, window, timeout). 1.0 = the catalog's real windows; only
# tests and local demos shorten it. Read by the remediation worker, which
# freezes the scaled spec into each verification.
VERIFICATION_TIME_SCALE=1.0
VERIFICATION_LEASE_SECONDS=60
# A failed verification re-investigates while attempts remain (and an alert
# is still firing); otherwise it escalates. Never re-executes on its own.
MAX_INVESTIGATION_ATTEMPTS=2

# --- Phase 8: dashboard (apps/dashboard) ---
# The Vite dev/preview server proxies /api to DASHBOARD_API_URL, else to
# http://localhost:${API_PORT}. The dashboard has no other backend access.
# DASHBOARD_API_URL=http://localhost:8000
# Carbon's packages send install telemetry unless disabled.
IBM_TELEMETRY_DISABLED=true
