{
  "id": "deployment-without-causal-evidence",
  "title": "Old deployment, new errors",
  "kind": "negative",
  "description": "checkout-service was deployed 45 minutes before errors began; nothing else links the deployment to the errors. Temporal proximity alone is not causal evidence.",
  "service": "checkout-service",
  "initial_conditions": "checkout-service deployed at -45 min and healthy for 35 minutes after.",
  "observable_symptoms": [
    "deployment at -45 min",
    "error rate rises at -8 min",
    "no error logs referencing the new code"
  ],
  "alerts": [
    {
      "alertname": "HighErrorRate",
      "alert_type": "availability",
      "summary": "checkout-service 5xx ratio above 10%",
      "description": "Share of checkout requests answered with 5xx exceeded 10% for 5 minutes."
    }
  ],
  "world": {
    "metrics": {
      "checkout-service": {
        "error_rate": {
          "series": {
            "change_at_min": -8,
            "baseline": 0.002,
            "incident": 0.2
          }
        }
      }
    },
    "logs": {
      "checkout-service": [
        {
          "at_min": -6,
          "severity": "INFO",
          "message": "request completed",
          "count": 20
        }
      ]
    },
    "deployments": [
      {
        "service": "checkout-service",
        "at_min": -45,
        "version": "4.4.0",
        "previous_version": "4.3.2"
      }
    ]
  },
  "expected": {
    "outcome": "ESCALATED",
    "acceptable_escalation_reasons": [
      "inconclusive",
      "budget_exhausted"
    ],
    "required_evidence": [
      {
        "type": "deployment",
        "service": "checkout-service"
      },
      {
        "type": "metric",
        "service": "checkout-service",
        "operation": "metric_window:error_rate"
      }
    ]
  }
}
